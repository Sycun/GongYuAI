{
  "name": "@gongyuai/contracts",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chat-input": {
      "types": "./dist/chat-input.d.ts",
      "import": "./dist/chat-input.js"
    },
    "./chat-model-options": {
      "types": "./dist/chat-model-options.d.ts",
      "import": "./dist/chat-model-options.js"
    },
    "./coverage": {
      "types": "./dist/coverage.d.ts",
      "import": "./dist/coverage.js"
    },
    "./integration-usage": {
      "types": "./dist/integration-usage.d.ts",
      "import": "./dist/integration-usage.js"
    },
    "./finding-report": {
      "types": "./dist/finding-report.d.ts",
      "import": "./dist/finding-report.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage \"src/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
