{
  "name": "@gongyuai/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "gy": "./dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@gongyuai/contracts": "workspace:*",
    "@gongyuai/control-plane": "workspace:*",
    "@gongyuai/history": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
