{
  "name": "@gongyuai/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@douyinfe/semi-icons": "^2.89.1",
    "@douyinfe/semi-ui": "^2.89.1",
    "@gongyuai/contracts": "workspace:*",
    "@xyflow/react": "^13.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.2",
    "vite": "^6.0.7"
  }
}
