{
  "name": "gongyuai",
  "private": true,
  "version": "0.1.0",
  "description": "AI-native long-running authorized pentest agent (Pi Durable + History + Docker workers)",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r run build && pnpm run build:netd",
    "build:netd": "node scripts/build-netd.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "build:console": "pnpm --filter @gongyuai/console build",
    "dev": "tsx apps/cli/src/index.ts",
    "dev:console": "pnpm --filter @gongyuai/console dev",
    "gy": "tsx apps/cli/src/index.ts",
    "test": "pnpm -r run test",
    "smoke": "tsx scripts/smoke.ts",
    "review:offline": "node --import tsx --test packages/history/src/review-acceptance.test.ts",
    "diff-harness": "tsx scripts/diff-harness.ts",
    "diff-run-metrics": "tsx scripts/diff-run-metrics.ts",
    "diff-harness:offline": "tsx scripts/diff-harness-offline.ts",
    "diff-harness:tsec": "tsx scripts/diff-harness.ts --mock --goals examples/tsecbench/goals-subset-diff.json --target example.invalid --auth \"Local synthetic P3 fixture only\"",
    "tsecbench": "tsx scripts/tsecbench.ts",
    "typecheck": "pnpm -r run typecheck",
    "smoke:tools": "tsx scripts/smoke-tools.ts",
    "smoke:unlock": "tsx scripts/smoke-tools-unlock.ts",
    "e2e:engagement": "tsx scripts/engagement-e2e.ts",
    "drill:restore": "tsx scripts/restore-drill.ts",
    "verify:acceptance": "tsx scripts/acceptance-verify.ts",
    "test:acceptance": "node --import tsx --test scripts/verify-acceptance.test.ts",
    "acceptance:mcp-load": "tsx scripts/acceptance-mcp-load.ts",
    "acceptance:business": "tsx scripts/business-acceptance.ts",
    "acceptance:paused-archive": "tsx scripts/paused-archive-acceptance.ts",
    "acceptance:firstpass": "tsx scripts/firstpass-binding-acceptance.ts",
    "acceptance:r9:ops": "tsx scripts/acceptance-r9-ops.ts",
    "acceptance:r9:flywheel": "tsx scripts/acceptance-r9-flywheel.ts",
    "acceptance:r9": "pnpm acceptance:r9:ops && pnpm acceptance:r9:flywheel",
    "restore:selftest": "tsx scripts/restore-isolation.ts selftest",
    "restore:isolation": "tsx scripts/restore-isolation.ts",
    "knowledge:acceptance": "tsx scripts/knowledge-acceptance.ts",
    "knowledge:hybrid-acceptance": "tsx scripts/knowledge-hybrid-acceptance.ts",
    "knowledge:provider-console": "tsx scripts/knowledge-provider-console.ts",
    "acceptance:shell-c2": "tsx scripts/shell-c2-acceptance.ts",
    "eval:p17": "tsx scripts/p17-eval.ts"
  },
  "dependencies": {
    "@gongyuai/contracts": "workspace:*",
    "@gongyuai/control-plane": "workspace:*",
    "@gongyuai/history": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "@types/node": "^24.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
